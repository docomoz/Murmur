/* English for the App Intents (Shortcuts, Spotlight, Siri, Focus filter).
   Keys are the Russian literals in Sources/Murmur/Intents.swift. The rest of the UI
   is translated in code with L("…", "…") and doesn't use this file. */

/* Mix entity */
"Микс" = "Mix";

/* Errors */
"Murmur ещё не запустился, попробуйте ещё раз." = "Murmur hasn't started yet, please try again.";
"Такого микса больше нет." = "This mix no longer exists.";

/* Play a mix */
"Включить микс" = "Play Mix";
"Включает готовый или сохранённый микс Murmur." = "Plays a built-in or saved Murmur mix.";
"Какой микс включить?" = "Which mix?";
"Включить микс ${mix}" = "Play mix ${mix}";

/* Shuffle */
"Наугад" = "Shuffle";
"Включает случайный, но правдоподобный микс: главный звук и один-два подходящих к нему." = "Plays a random but believable mix: one main sound plus one or two that belong with it.";

/* Play / pause */
"Пауза / Играть" = "Play / Pause";
"Ставит звук на паузу или продолжает играть. Если ничего не выбрано, включает микс наугад." = "Pauses or resumes the sound. If nothing is selected, plays a random mix.";
"Играть" = "Play";
"Продолжает играть текущий микс. Если ничего не выбрано, включает микс наугад." = "Resumes the current mix. If nothing is selected, plays a random mix.";
"Пауза" = "Pause";
"Ставит звук на паузу; микс сохраняется." = "Pauses the sound and keeps the mix.";

/* Stop */
"Остановить" = "Stop";
"Выключает все звуки и таймер сна." = "Turns off all sounds and the sleep timer.";

/* Sleep timer */
"Таймер сна" = "Sleep Timer";
"Через заданное время звук плавно стихнет. Если ничего не играет, включится текущий микс." = "The sound fades out after the given time. If nothing is playing, the current mix starts.";
"Минуты" = "Minutes";
"Таймер сна на ${minutes} мин" = "Sleep timer for ${minutes} min";
"Выключить таймер сна" = "Cancel Sleep Timer";
"Отменяет таймер сна; звук продолжает играть." = "Cancels the sleep timer; the sound keeps playing.";

/* Volume */
"Громкость Murmur" = "Murmur Volume";
"Устанавливает общую громкость Murmur." = "Sets Murmur's overall volume.";
"Громкость" = "Volume";
"Громкость Murmur: ${percent}" = "Murmur volume: ${percent}";

/* Focus filter */
"Микс Murmur" = "Murmur Mix";
"Включает микс, когда включается режим фокусирования." = "Plays a mix when the Focus turns on.";
"Пауза, когда режим выключится" = "Pause when the Focus ends";
"Без микса" = "No mix";
